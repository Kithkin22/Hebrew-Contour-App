const PROJECTS_STORE_KEY='hebrewContourApp.projects.v1';
const CURRENT_PROJECT_ID_KEY='hebrewContourApp.currentProjectId.v1';
const LEGACY_STORAGE_KEY='hebrewContourApp.currentProject.v1';
const LEGACY_AUTOSAVE_KEY='hebrewContourApp.autosave.v1';
const APP_VERSION='1.3.8';
let projectStore={currentProjectId:null,projects:{}};
function newProjectId(){return 'p_'+Date.now().toString(36)+'_'+Math.random().toString(36).slice(2,8);}
function defaultProjectName(){const ref=(state&&state.ref)?String(state.ref).trim():'';return ref||'Untitled Project';}
function readProjectStoreRaw(){try{const raw=localStorage.getItem(PROJECTS_STORE_KEY);if(raw)return JSON.parse(raw);}catch(e){}return null;}
function writeProjectStore(){localStorage.setItem(PROJECTS_STORE_KEY,JSON.stringify({currentProjectId:projectStore.currentProjectId,projects:projectStore.projects}));localStorage.setItem(CURRENT_PROJECT_ID_KEY,projectStore.currentProjectId||'');}
function getCurrentProjectRecord(){return projectStore.currentProjectId?projectStore.projects[projectStore.currentProjectId]||null:null;}
function updateCurrentProjectLabel(){const el=document.getElementById('currentProjectName');const rec=getCurrentProjectRecord();if(el)el.textContent=rec?rec.name:'Untitled Project';}
function projectPayloadFromState(st,refs){return {app:'Hebrew Contour Table App',version:APP_VERSION,savedAt:new Date().toISOString(),state:st,generatedRefs:refs||[]};}
function projectPayload(){const rec=getCurrentProjectRecord();return {app:'Hebrew Contour Table App',version:APP_VERSION,savedAt:new Date().toISOString(),projectName:rec?rec.name:defaultProjectName(),state:state,generatedRefs:generatedRefs};}
function uniqueProjectName(base){let name=(base||'Untitled Project').trim()||'Untitled Project';if(!projectStore.projects||!Object.values(projectStore.projects).some(p=>p.name===name))return name;let n=2;while(Object.values(projectStore.projects).some(p=>p.name===name+' ('+n+')'))n++;return name+' ('+n+')';}
function migrateLegacyProjects(){if(readProjectStoreRaw())return false;let legacy=null;try{const raw=localStorage.getItem(LEGACY_AUTOSAVE_KEY)||localStorage.getItem(LEGACY_STORAGE_KEY);if(raw)legacy=JSON.parse(raw);}catch(e){}const id=newProjectId();const now=new Date().toISOString();const name=legacy&&legacy.state&&legacy.state.ref?String(legacy.state.ref).trim():(legacy?'Recovered Autosave':'Untitled Project');projectStore={currentProjectId:id,projects:{}};if(legacy&&legacy.state&&Array.isArray(legacy.state.verses)){projectStore.projects[id]={id,name,createdAt:legacy.savedAt||now,updatedAt:legacy.savedAt||now,appVersion:APP_VERSION,payload:legacy};}else{projectStore.projects[id]={id,name,createdAt:now,updatedAt:now,appVersion:APP_VERSION,payload:projectPayloadFromState(freshProjectState(),[])};}writeProjectStore();try{localStorage.removeItem(LEGACY_AUTOSAVE_KEY);localStorage.removeItem(LEGACY_STORAGE_KEY);}catch(e){}return !!legacy;}
function freshProjectState(){return {ref:'',verses:[],selected:null,columns:[],language:'hebrew',legend:[],inclusios:[],comments:[],activeCommentId:null,arcs:[],activeArcId:null};}
function applyProjectPayload(payload){let data=(payload&&payload.state)?payload:{state:payload};if(!data.state||!Array.isArray(data.state.verses))throw new Error('Missing project state');state=data.state;generatedRefs=Array.isArray(data.generatedRefs)?data.generatedRefs:[];if(!state.columns)state.columns=[];if(!Array.isArray(state.legend))state.legend=[];if(!Array.isArray(state.inclusios))state.inclusios=[];if(!Array.isArray(state.comments))state.comments=[];if(!Array.isArray(state.arcs))state.arcs=[];state.activeArcId=null;state.activeCommentId=null;state.selected=null;if(document.getElementById('textSource')){const lang=state.language==='greek'?'greek':(state.language==='hebrew-bhsa'?'hebrew-bhsa':'hebrew');document.getElementById('textSource').value=lang;setupBooks();}if(document.getElementById('pasteBox')){const pb=document.getElementById('pasteBox');pb.dir=state.language==='greek'?'ltr':'rtl';pb.classList.remove('heb','greek');pb.classList.add(state.language==='greek'?'greek':'heb');}const refBox=document.getElementById('refBox');if(refBox)refBox.value=state.ref||'';}
function restoreProjectPayload(payload){try{applyProjectPayload(payload);render();return true;}catch(e){alert('Could not load that project file/save.');return false;}}
function persistCurrentProject(silent){const id=projectStore.currentProjectId;if(!id)return;const now=new Date().toISOString();const payload=projectPayload();let rec=projectStore.projects[id];if(rec){rec.payload=payload;rec.updatedAt=now;if((!rec.name||rec.name==='Untitled Project')&&defaultProjectName()!=='Untitled Project')rec.name=defaultProjectName();}else{rec={id,name:defaultProjectName(),createdAt:now,updatedAt:now,appVersion:APP_VERSION,payload};projectStore.projects[id]=rec;}writeProjectStore();updateCurrentProjectLabel();if(!silent){const rec2=getCurrentProjectRecord();updateSaveStatus('Saved: '+(rec2?rec2.name:'project')+' · '+new Date().toLocaleTimeString());}}
function autoSaveProject(){try{persistCurrentProject(true);const rec=getCurrentProjectRecord();updateSaveStatus('Autosaved: '+(rec?rec.name:'project')+' · '+new Date().toLocaleTimeString());}catch(e){updateSaveStatus('Autosave unavailable in this browser.');}}
function switchToProject(id){if(!projectStore.projects[id])return false;persistCurrentProject(true);projectStore.currentProjectId=id;writeProjectStore();const rec=projectStore.projects[id];if(!restoreProjectPayload(rec.payload))return false;updateCurrentProjectLabel();updateSaveStatus('Opened: '+rec.name);return true;}
function initProjectManager(){const stored=readProjectStoreRaw();if(stored&&stored.projects){projectStore={currentProjectId:stored.currentProjectId,projects:stored.projects||{}};}else{migrateLegacyProjects();}if(!projectStore.currentProjectId||!projectStore.projects[projectStore.currentProjectId]){const ids=Object.keys(projectStore.projects).sort((a,b)=>(projectStore.projects[b].updatedAt||'').localeCompare(projectStore.projects[a].updatedAt||''));if(ids.length){projectStore.currentProjectId=ids[0];}else{const id=newProjectId();const now=new Date().toISOString();projectStore.currentProjectId=id;projectStore.projects[id]={id,name:'Untitled Project',createdAt:now,updatedAt:now,appVersion:APP_VERSION,payload:projectPayloadFromState(freshProjectState(),[])};}writeProjectStore();}const rec=getCurrentProjectRecord();if(rec&&rec.payload&&rec.payload.state&&Array.isArray(rec.payload.state.verses)&&rec.payload.state.verses.length){try{applyProjectPayload(rec.payload);updateSaveStatus('Restored: '+rec.name+' · last edited '+new Date(rec.updatedAt||rec.createdAt).toLocaleString());}catch(e){updateSaveStatus('Could not restore '+rec.name+'. Starting blank.');}}updateCurrentProjectLabel();}
function createNewProject(name){persistCurrentProject(true);const id=newProjectId();const now=new Date().toISOString();const n=uniqueProjectName((name||'').trim()||'Untitled Project');projectStore.projects[id]={id,name:n,createdAt:now,updatedAt:now,appVersion:APP_VERSION,payload:projectPayloadFromState(freshProjectState(),[])};projectStore.currentProjectId=id;writeProjectStore();state=freshProjectState();generatedRefs=[];const pasteBox=document.getElementById('pasteBox');const refBox=document.getElementById('refBox');if(pasteBox){pasteBox.value='';pasteBox.dir='rtl';}if(refBox)refBox.value='';const wasReady=autosaveReady;autosaveReady=false;render();autosaveReady=wasReady;updateCurrentProjectLabel();updateSaveStatus('New project: '+n);}
function clearTableProject(silent){if(!silent&&!confirm('Clear all text, annotations, and table content in this project?'))return;state=freshProjectState();generatedRefs=[];const pasteBox=document.getElementById('pasteBox');const refBox=document.getElementById('refBox');if(pasteBox)pasteBox.value='';if(refBox)refBox.value='';persistCurrentProject(true);const wasReady=autosaveReady;autosaveReady=false;render();autosaveReady=wasReady;updateSaveStatus('Table cleared.');}
function updateSaveStatus(msg){let el=document.getElementById('saveStatus');if(el)el.textContent=msg;}
function saveProjectLocal(){try{persistCurrentProject(false);alert('Project saved in this browser. Use Open Project to switch between saved passages.');}catch(e){alert('Could not save in this browser. Try Export Project JSON instead.');}}
function renderProjectPickerList(){const list=document.getElementById('projectPickerList');if(!list)return;const entries=Object.values(projectStore.projects).sort((a,b)=>(b.updatedAt||'').localeCompare(a.updatedAt||''));if(!entries.length){list.innerHTML='<li class="project-list-empty muted">No saved projects yet.</li>';return;}list.innerHTML=entries.map(p=>'<li tabindex="0" data-id="'+esc(p.id)+'"><span><span class="project-list-name">'+esc(p.name)+'</span>'+(p.id===projectStore.currentProjectId?' <span class="muted">(current)</span>':'')+'</span><span class="project-list-meta">'+esc(new Date(p.updatedAt||p.createdAt).toLocaleString())+'</span></li>').join('');list.querySelectorAll('li[data-id]').forEach(li=>{const open=()=>{document.getElementById('projectPickerModal').classList.remove('show');switchToProject(li.dataset.id);};li.onclick=open;li.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();open();}};});}
function openProjectPicker(){renderProjectPickerList();const modal=document.getElementById('projectPickerModal');if(modal){modal.classList.add('show');modal.setAttribute('aria-hidden','false');}}
function closeProjectPicker(){const modal=document.getElementById('projectPickerModal');if(modal){modal.classList.remove('show');modal.setAttribute('aria-hidden','true');}}
function newProjectPrompt(){promptModal('New project','Name this passage worksheet:','Untitled Project',name=>{if((name||'').trim())createNewProject(name);});}
function renameCurrentProject(){const cur=getCurrentProjectRecord();if(!cur)return;promptModal('Rename project','Project name:',cur.name,name=>{const n=(name||'').trim();if(!n)return;cur.name=n;writeProjectStore();updateCurrentProjectLabel();updateSaveStatus('Renamed to: '+n);});}
function duplicateCurrentProject(){const cur=getCurrentProjectRecord();if(!cur)return;persistCurrentProject(true);promptModal('Duplicate project','Name for the copy:',cur.name+' copy',name=>{const n=(name||'').trim();if(!n)return;const id=newProjectId();const now=new Date().toISOString();projectStore.projects[id]={id,name:uniqueProjectName(n),createdAt:now,updatedAt:now,appVersion:APP_VERSION,payload:JSON.parse(JSON.stringify(projectPayload()))};switchToProject(id);});}
function deleteCurrentProject(){const cur=getCurrentProjectRecord();if(!cur)return;if(!confirm('Delete project "'+cur.name+'"? Export it first if you may need it later.'))return;delete projectStore.projects[cur.id];const ids=Object.keys(projectStore.projects).sort((a,b)=>(projectStore.projects[b].updatedAt||'').localeCompare(projectStore.projects[a].updatedAt||''));if(ids.length){projectStore.currentProjectId=ids[0];writeProjectStore();switchToProject(ids[0]);}else{const id=newProjectId();const now=new Date().toISOString();projectStore.currentProjectId=id;projectStore.projects[id]={id,name:'Untitled Project',createdAt:now,updatedAt:now,appVersion:APP_VERSION,payload:projectPayloadFromState(freshProjectState(),[])};writeProjectStore();state=freshProjectState();generatedRefs=[];const wasReady=autosaveReady;autosaveReady=false;render();autosaveReady=wasReady;updateCurrentProjectLabel();updateSaveStatus('Project deleted. Started a new blank project.');}}
function downloadProjectFile(){persistCurrentProject(true);const rec=getCurrentProjectRecord();let payload=JSON.stringify(projectPayload(),null,2);let ref=(rec?rec.name:state.ref||'hebrew-contour-project').replace(/[^A-Za-z0-9_-]+/g,'-').replace(/^-+|-+$/g,'')||'hebrew-contour-project';let a=document.createElement('a');a.href=URL.createObjectURL(new Blob([payload],{type:'application/json'}));a.download=ref+'.json';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);updateSaveStatus('Exported: '+ref+'.json');}
function importProjectFile(file){if(!file)return;let reader=new FileReader();reader.onload=()=>{try{const data=JSON.parse(reader.result);let payload=(data&&data.state)?data:{state:data};if(!payload.state||!Array.isArray(payload.state.verses))throw new Error('Missing project state');persistCurrentProject(true);const id=newProjectId();const now=new Date().toISOString();const baseName=(data.projectName||payload.state.ref||file.name.replace(/\.json$/i,'')||'Imported Project').trim();const name=uniqueProjectName(baseName);projectStore.projects[id]={id,name,createdAt:now,updatedAt:now,appVersion:APP_VERSION,payload:(data&&data.state)?data:payload};projectStore.currentProjectId=id;writeProjectStore();restoreProjectPayload(projectStore.projects[id].payload);updateCurrentProjectLabel();updateSaveStatus('Imported: '+name);}catch(e){alert('Could not import that project JSON file.');}};reader.readAsText(file);}
document.getElementById('newProjectBtn').onclick=newProjectPrompt;
document.getElementById('openProjectBtn').onclick=openProjectPicker;
document.getElementById('saveLocalBtn').onclick=saveProjectLocal;
document.getElementById('duplicateProjectBtn').onclick=duplicateCurrentProject;
document.getElementById('renameProjectBtn').onclick=renameCurrentProject;
document.getElementById('deleteProjectBtn').onclick=deleteCurrentProject;
document.getElementById('downloadProjectBtn').onclick=downloadProjectFile;
document.getElementById('importProjectBtn').onclick=()=>document.getElementById('projectFileInput').click();
document.getElementById('projectFileInput').onchange=e=>{importProjectFile(e.target.files[0]);e.target.value='';};
document.getElementById('clearTableBtn').onclick=()=>clearTableProject(false);
document.getElementById('projectPickerCloseBtn').onclick=closeProjectPicker;
document.getElementById('projectPickerModal').addEventListener('click',e=>{if(e.target.id==='projectPickerModal')closeProjectPicker();});
document.addEventListener('keydown',function(e){if(e.key==='Escape'){const m=document.getElementById('projectPickerModal');if(m&&m.classList.contains('show'))closeProjectPicker();}});
